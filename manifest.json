{
	"manifest_version": 3,
	"name": "RequestID",
	"version": "1.0.0",
	"description": "Automatically injects Request-ID headers into outgoing HTTP requests for debugging and traceability.",
	"permissions": ["storage"],
	"background": {
		"service_worker": "src/background.js"
	},
	"action": {
		"default_popup": "src/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/injected.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["src/content.js"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["src/injected.js"],
			"matches": ["<all_urls>"]
		}
	],
	"offline_enabled": true
}
