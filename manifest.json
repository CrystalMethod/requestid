{
	"manifest_version": 3,
	"name": "RequestID",
	"version": "1.0.0",
	"description": "Automatically injects Request-ID headers into outgoing HTTP requests for debugging and traceability.",
	"permissions": ["storage"],
	"background": {
		"service_worker": "src/background.js"
	},
	"action": {
		"default_popup": "src/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/content.js"]
		}
	],
	"offline_enabled": true
}
